{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run NeuroFocus AI (web app)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run official experiment (experiment_v1)",
      "type": "debugpy",
      "request": "launch",
      "module": "research.pipeline.run_experiment",
      "args": ["--config", "research/config/experiment_v1.json"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
